{
  // Copy values into src/MigrationTool.Host/appsettings.json or set MIGRATION_CONNECTION_STRING.
  // Do not commit real passwords.
  //
  // Validate before polling:
  //   dotnet run --project src/MigrationTool.Host -- --validate-connection
  // Optional override:
  //   dotnet run --project src/MigrationTool.Host -- --validate-connection --connection "Data Source=...;..."
  //
  // --- SQL Server examples (Provider = SqlServer) ---
  //
  // AWS RDS for SQL Server (Data Source + port 1433):
  // Data Source=mydb.abc123.us-east-1.rds.amazonaws.com,1433;Initial Catalog=your-db;User ID=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=False;
  //
  // AWS RDS for SQL Server (Server keyword + port 1433):
  // Server=mydb.abc123.us-east-1.rds.amazonaws.com,1433;Database=your-db;User Id=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=False;
  //
  // Azure SQL / SQL Server cloud:
  // Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-db;User ID=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=False;
  //
  // Local SQL Server:
  // Server=.;Database=your-db;Trusted_Connection=True;TrustServerCertificate=True;
  //
  // --- PostgreSQL examples (Provider = PostgreSql) ---
  //
  // Azure Database for PostgreSQL, Amazon RDS, or Cloud SQL:
  // Host=your-host.postgres.database.azure.com;Port=5432;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=false
  "Migration": {
    "Provider": "SqlServer",
    "ConnectionString": "",
    "InboxPath": "scripts/inbox",
    "SuccessPath": "scripts/success",
    "FailedPath": "scripts/failed",
    "MaxRetries": 4,
    "PollCron": "*/1 * * * *",
    "JournalSchema": "migration",
    "JournalTable": "schema_versions",
    "CommandTimeoutSeconds": 600,
    "RepairMissingColumns": true
  }
}
