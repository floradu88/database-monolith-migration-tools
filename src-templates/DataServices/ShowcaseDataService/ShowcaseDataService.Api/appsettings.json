{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SqlConnections": {
    "OwnedConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ShowcaseOwned;Trusted_Connection=True;TrustServerCertificate=True",
    "SourceFacadeConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ShowcaseSource;Trusted_Connection=True;TrustServerCertificate=True",
    "AllowDbOwner": false
  },
  "MigrationRouting": {
    "DefaultRoute": "SourceFacade",
    "Slot": "Blue",
    "RouteHeaderName": "X-Data-Access-Route",
    "SlotHeaderName": "X-Blue-Green-Slot"
  }
}
