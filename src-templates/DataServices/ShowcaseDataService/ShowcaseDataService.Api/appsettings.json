{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Schema": "showcase",
    "DeploymentSchema": "deployment",
    "LegacySchema": "dbo",
    "CoreSchema": "core",
    "AllowDbOwner": false,
    "Owned": {
      "Provider": "OnPrem",
      "AuthMode": "ConnectionString",
      "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ShowcaseOwned;Trusted_Connection=True;TrustServerCertificate=True",
      "ApplicationName": "ShowcaseDataService.Owned"
    },
    "SourceFacade": {
      "Provider": "OnPrem",
      "AuthMode": "ConnectionString",
      "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ShowcaseSource;Trusted_Connection=True;TrustServerCertificate=True",
      "ApplicationName": "ShowcaseDataService.SourceFacade"
    }
  },
  "MigrationRouting": {
    "DefaultRoute": "SourceFacade",
    "Slot": "Blue",
    "AuthoritativeMethod": "EfCore",
    "RouteHeaderName": "X-Data-Access-Route",
    "SlotHeaderName": "X-Blue-Green-Slot",
    "MethodHeaderName": "X-Data-Access-Method",
    "ParallelWriteCoreTimeoutMs": 2000,
    "SourceSchema": "dbo",
    "OwnedSchema": "core"
  },
  // Auth:RequireJwt is lab-off by default (see ../AUTH.md).
  // Authority / Audience / ManagedIdentityClientId: set from real IdP / Key Vault — do not invent secrets.
  // Database:* AuthMode (SQL MI / connection) is separate — see ../DATABASE-HOSTING.md.
  "Auth": {
    "RequireJwt": false,
    "Authority": "",
    "Audience": "showcase-dataservice",
    "ManagedIdentityClientId": ""
  },
  "Slo": {
    "ReadLatencyP95MsBudget": 200,
    "ErrorRateBudgetPercent": 1
  }
}
