<?xml version="1.0" encoding="utf-8"?>
<!--
  Golden hybrid SQL project: owns schemas, SPs, security, and DatabaseContract.
  Does NOT build EF-owned tables (see Reference/EfOwned) or Cutover up/down scripts (None).
  Version desired-state objects via git + dacpac; use Cutover/ for ordered reversible waves.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <Name>ShowcaseDataService.Database</Name>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{B1111111-2222-3333-4444-555555555501}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <OutputType>Database</OutputType>
    <RootPath />
    <RootNamespace>ShowcaseDataService.Database</RootNamespace>
    <AssemblyName>ShowcaseDataService.Database</AssemblyName>
    <ModelCollation>1033,CI</ModelCollation>
    <DefaultFileStructure>BySchemaObjectType</DefaultFileStructure>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <!-- Stamp used by PostDeploy contract row (override at publish if needed). -->
    <DatabaseContractVersion>1.0.0-showcase</DatabaseContractVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <BuildScriptName>ShowcaseDataService.Database.sql</BuildScriptName>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
    <BuildScriptName>ShowcaseDataService.Database.sql</BuildScriptName>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Security\" />
    <Folder Include="Contract\" />
    <Folder Include="Programmability\" />
    <Folder Include="Programmability\Generated\" />
    <Folder Include="Tables\" />
    <Folder Include="Scripts\" />
    <Folder Include="Cutover\" />
    <Folder Include="Reference\EfOwned\" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQL-project-owned (desired state → dacpac). -->
    <Build Include="Security\Schemas.sql" />
    <Build Include="Contract\DatabaseContract.sql" />
    <Build Include="Programmability\GetShowcaseSummary.sql" />
    <Build Include="Programmability\usp_Showcase_Sales_Summary.sql" />
    <Build Include="Programmability\usp_Showcase_Sales_Detail.sql" />
    <Build Include="Programmability\usp_Showcase_Inventory_Summary.sql" />
    <Build Include="Programmability\usp_Showcase_Inventory_Detail.sql" />
    <Build Include="Tables\dbo.ShowcaseWorkItem.sql" />
    <Build Include="Tables\core.ShowcaseWorkItem.sql" />
    <Build Include="Tables\core.DualWriteControl.sql" />
    <Build Include="Programmability\dbo.usp_ShowcaseWorkItem_Upsert.sql" />
    <Build Include="Programmability\dbo.usp_ShowcaseWorkItem_Delete.sql" />
    <Build Include="Programmability\core.usp_ShowcaseWorkItem_Upsert.sql" />
    <Build Include="Programmability\core.usp_ShowcaseWorkItem_Delete.sql" />
    <Build Include="Programmability\core.usp_DualWriteSupport.sql" />
    <!-- FindingsMigration writes stubs under Programmability\Generated\ — add each Build Include when promoting. -->
    <PreDeploy Include="Scripts\PreDeploy.sql" />
    <PostDeploy Include="Scripts\PostDeploy.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Not Build: EF owns showcase.Items — reference shape only (never dual-own). -->
    <None Include="Reference\EfOwned\Items.reference.sql" />
    <!-- Not Build: ordered cutover up/down applied by DBA/control-plane, not SSDT publish model. -->
    <None Include="Cutover\**\*.sql" />
    <None Include="Cutover\README.md" />
    <None Include="object-ownership.yml" />
    <None Include="README.md" />
    <None Include="AI-INSTRUCTIONS.md" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\SSDT\Microsoft.Data.Tools.Schema.SqlTasks.targets" Condition="'$(SQLDBExtensionsRefPath)' == '' AND Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\SSDT\Microsoft.Data.Tools.Schema.SqlTasks.targets')" />
</Project>
