{
  "Urls": "http://127.0.0.1:5088",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "Migration": {
    "Provider": "SqlServer",
    "ConnectionString": "",
    "InboxPath": "scripts/inbox",
    "SuccessPath": "scripts/success",
    "FailedPath": "scripts/failed",
    "MaxRetries": 4,
    "PollCron": "*/1 * * * *",
    "JournalSchema": "migration",
    "JournalTable": "schema_versions",
    "CommandTimeoutSeconds": 600,
    "RepairMissingColumns": true,
    "SyncCreateTableColumns": true
  }
}
